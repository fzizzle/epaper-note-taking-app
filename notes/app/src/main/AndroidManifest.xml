<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "All files access": the app edits the owner's PDFs in place, in their own folders (spec §6.1). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".NotesApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Jot"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Jot"
        tools:replace="android:icon,android:label,android:roundIcon,android:theme">

        <!-- The library (spec §6.1). Turning the tablet only changes how many tiles fit across. -->
        <activity
            android:name=".ui.LibraryActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Turning the tablet must not restart the writing screen: the open document and its
             saving carry on, and the page just refits (spec §6.2: the screen follows the tablet). -->
        <activity
            android:name=".ui.WritingActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="false" />
    </application>
</manifest>
